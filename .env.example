# ==============================================================================
# RAMAIAH INSTITUTE OF TECHNOLOGY - APPRAISAL SYSTEM ENVIRONMENT TEMPLATE
# Copy this file to '.env' and fill in your actual production/environment secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & NETWORK SETTINGS
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV="development" # Options: 'development', 'production', 'test'
CLIENT_URL="http://localhost:5173" # Allowed CORS origin for frontend SPA

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Connection string with PgBouncer connection pooling for API requests
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=30"
# Direct PostgreSQL connection string for Prisma CLI migrations & schema push
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres"

# Supabase API (Optional external integrations)
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-2026" # Secret key for signing JWT tokens
JWT_EXPIRES_IN="24h" # Token validity duration (e.g., '12h', '24h', '7d')

# ------------------------------------------------------------------------------
# 4. FILE STORAGE & PROOF UPLOAD LIMITS
# ------------------------------------------------------------------------------
UPLOAD_DIR="./uploads" # Directory on disk where proof PDFs/images are stored
MAX_FILE_SIZE_MB=10 # Maximum allowed size per individual upload in MB (Default: 10)
UPLOAD_QUOTA_MB=50 # Cumulative upload quota per application in MB (Default: 50)
MAX_FILES_PER_APP=40 # Maximum cumulative file attachments per application (Default: 40)

# ------------------------------------------------------------------------------
# 5. SECURITY & RATE LIMITING KNOBS
# ------------------------------------------------------------------------------
AUTH_RATE_LIMIT_MAX=100 # Max login attempts per IP per 15 minutes
UPLOAD_RATE_LIMIT_MINS=15 # Upload rate-limit window in minutes (Default: 15)
UPLOAD_RATE_LIMIT_MAX_REQ=30 # Max upload requests allowed per IP window (Default: 30)

# ------------------------------------------------------------------------------
# 6. AUTOMATED BACKGROUND JOBS
# ------------------------------------------------------------------------------
ENABLE_AUTO_REMINDERS="true" # Set to 'true' to enable cron notification reminders for pending reviews

# ------------------------------------------------------------------------------
# 7. SMTP EMAIL NOTIFICATIONS
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="admin_appraisal@yourdomain.edu"
SMTP_PASS="your-smtp-app-password-here"
EMAIL_FROM='"RIT Appraisal System" <admin_appraisal@yourdomain.edu>'
