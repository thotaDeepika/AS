generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department { 
  id         String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  users      User[]

  @@map("departments")
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  password_hash    String
  name             String
  role             Role          @default(FACULTY)
  designation      Designation?
  department_id    String
  is_active        Boolean       @default(true)
  joining_date     DateTime?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  applications     Application[] @relation("FacultyApplications")
  assigned_reviews Application[] @relation("ReviewerAssignments")
  audit_logs       AuditLog[]
  reviews          Review[]
  department       Department    @relation(fields: [department_id], references: [id])

  @@map("users")
}

model Application {
  id               String            @id @default(uuid())
  faculty_id       String
  academic_year    String
  status           ApplicationStatus @default(DRAFT)
  total_score      Decimal           @default(0) @db.Decimal(6, 2)
  bonus_score      Decimal?          @db.Decimal(6, 2)
  reviewer_score   Decimal?          @db.Decimal(6, 2)
  final_score      Decimal           @default(0) @db.Decimal(6, 2)
  submitted_at     DateTime?
  frozen_at        DateTime?
  reviewer_id      String?
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  faculty          User              @relation("FacultyApplications", fields: [faculty_id], references: [id])
  reviewer         User?             @relation("ReviewerAssignments", fields: [reviewer_id], references: [id])
  category_entries CategoryEntry[]
  reviews          Review[]

  @@unique([faculty_id, academic_year])
  @@map("applications")
}

model ScoringCategory {
  id               String          @id @default(uuid())
  sl_no            Int
  section          ScoringSection
  name             String
  description      String?
  input_type       String
  input_config     Json?
  is_active        Boolean         @default(true)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  category_entries CategoryEntry[]
  scoring_rules    ScoringRule[]

  @@map("scoring_categories")
}

model ScoringRule {
  id            String          @id @default(uuid())
  category_id   String
  designation   Designation
  max_weightage Decimal         @db.Decimal(6, 2)
  formula       Json
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  category      ScoringCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([category_id, designation])
  @@map("scoring_rules")
}

model CategoryEntry {
  id               String          @id @default(uuid())
  application_id   String
  category_id      String
  raw_value        Json
  calculated_score Decimal         @default(0) @db.Decimal(6, 2)
  reviewer_score   Decimal?        @db.Decimal(6, 2)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  application      Application     @relation(fields: [application_id], references: [id], onDelete: Cascade)
  category         ScoringCategory @relation(fields: [category_id], references: [id])
  proof_documents  ProofDocument[]

  @@unique([application_id, category_id])
  @@map("category_entries")
}

model ProofDocument {
  id                String        @id @default(uuid())
  category_entry_id String
  file_name         String
  file_path         String
  file_size         Int
  mime_type         String        @default("application/pdf")
  item_index        Int?
  uploaded_at       DateTime      @default(now())
  category_entry    CategoryEntry @relation(fields: [category_entry_id], references: [id], onDelete: Cascade)

  @@map("proof_documents")
}

model Review {
  id               String         @id @default(uuid())
  application_id   String
  reviewer_user_id String
  role_at_review   Role
  decision         ReviewDecision
  comments         String?
  signature_path   String?
  reviewed_at      DateTime       @default(now())
  application      Application    @relation(fields: [application_id], references: [id], onDelete: Cascade)
  reviewer         User           @relation(fields: [reviewer_user_id], references: [id])

  @@map("reviews")
}

model AuditLog {
  id          String      @id @default(uuid())
  user_id     String
  action      AuditAction
  entity_type String
  entity_id   String?
  details     Json?
  ip_address  String?
  created_at  DateTime    @default(now())
  user        User        @relation(fields: [user_id], references: [id])

  @@map("audit_logs")
}

enum Role {
  FACULTY
  HOD
  REVIEWER
  PRINCIPAL
  ADMIN
  ACCOUNTS
}

enum Designation {
  ASSISTANT_PROFESSOR
  ASSOCIATE_PROFESSOR
  PROFESSOR
}

enum ApplicationStatus {
  DRAFT
  REVERTED
  SUBMITTED
  HOD_REVIEWED
  REVIEWER_ASSIGNED
  REVIEWER_REVIEWED
  PRINCIPAL_REVIEWED
  FROZEN
  SENT_TO_ACCOUNTS
}

enum ReviewDecision {
  RECOMMENDED
  NOT_RECOMMENDED
  APPROVED
  REJECTED
  REVERTED
}

enum AuditAction {
  LOGIN
  LOGOUT
  APPLICATION_CREATED
  APPLICATION_SUBMITTED
  APPLICATION_REVIEWED
  REVIEWER_ASSIGNED
  APPLICATION_FROZEN
  SENT_TO_ACCOUNTS
  FILE_UPLOADED
  COMMENT_ADDED
  USER_CREATED
  USER_UPDATED
  SCORING_CONFIG_UPDATED
  APPLICATION_HOD_REVIEWED
  APPLICATION_REVIEWER_REVIEWED
  APPLICATION_PRINCIPAL_REVIEWED
  STATUS_CHANGED
}

enum ScoringSection {
  TEACHING
  RESEARCH
  SERVICE
}
