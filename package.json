{
  "name": "appraisal-system",
  "version": "1.0.0",
  "private": true,
  "description": "Faculty Appraisal & Increment Management System - Ramaiah Institute of Technology",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "seed": "npm run seed --workspace=server",
    "prisma:migrate": "npx prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:studio": "npx prisma studio --schema=./prisma/schema.prisma",
    "prisma:generate": "npx prisma generate --schema=./prisma/schema.prisma"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
